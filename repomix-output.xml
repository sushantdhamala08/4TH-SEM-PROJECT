require_once '../../utils/auth.php';

$userId = authenticate();
$data = json_decode(file_get_contents("php://input"), true);

$id = $data['id'] ?? 0;
$amount = $data['amount'] ?? 0;
$type = $data['type'] ?? 'Monthly';

