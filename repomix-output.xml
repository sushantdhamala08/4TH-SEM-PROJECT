            </Card>
        </div>

        {/* Add/Edit Modal */}
        <AddIncomeModal 
            isOpen={isAddModalOpen} 
            onClose={() => setIsAddModalOpen(false)} 
            onSuccess={fetchHistory} 
            editData={editData} 
        />
        
      </div>
    </DashboardLayout>
  );
}
